// How Cloudflare publishes the map: the `poutine` Worker serves the built `dist` folder at
// poutines.app, and runs worker/index.ts for /api/* (address lookup, Add a place, ratings) and a
// place's short link (/labanquise, its preview naming the place).
// Connected to the GitHub repository (Workers Builds), each push to main runs `npm run build`,
// then `npx wrangler deploy` with this file. Deploying your own copy: change the name, the address
// and the database ID to yours, and set the TURNSTILE_SECRET and LINK_SECRET
// secrets.
{
  "name": "poutine",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Everything but the app's own files, so a place's short link (/labanquise) reaches the Worker
    // while the map's files stay plain static assets (free, never counted as Worker requests).
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/fonts/*",
      "!/map-assets/*",
      "!/icon.svg",
      "!/icons/*",
      "!/manifest.webmanifest",
      "!/share.png",
    ],
  },
  // Places visitors send, waiting for approval. migrations/ holds its tables.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poutine",
      "database_id": "cda35fa7-f7f0-4381-b063-5e8a209e97f3",
      "migrations_dir": "migrations",
    },
  ],
  // Wrangler replaces the Worker's addresses with these on each deploy. www answers with a redirect
  // to poutines.app (a Redirect Rule, which runs before the Worker); it stays here for its DNS
  // record and certificate. The first address, poutine.ederer.digital, belongs to another
  // Cloudflare account, whose own Redirect Rule sends it here.
  "routes": [
    { "pattern": "poutines.app", "custom_domain": true },
    { "pattern": "www.poutines.app", "custom_domain": true },
  ],
  // The approval page's sign-in (worker/access.ts): Cloudflare Access's public keys for Alex's team,
  // and the Access application's tag (neither is a secret). Empty: nobody gets into /admin.
  "vars": {
    "ACCESS_CERTS_URL": "https://tiny-grass-2498.cloudflareaccess.com/cdn-cgi/access/certs",
    "ACCESS_AUD": "406a8310936b73c705e66f7dda3428f0d826f0011bd8528c84e07fb4cc579ebf",
  },
  // An email to Alex for each new place (worker/mail.ts), through Email Routing on poutines.app; the
  // address is the secret MAIL_TO.
  "send_email": [{ "name": "MAIL" }],
  "workers_dev": false,
  "preview_urls": false,
}
