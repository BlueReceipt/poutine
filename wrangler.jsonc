// How Cloudflare publishes the map: the `poutine` Worker serves the built `dist` folder at
// poutines.app, and runs worker/index.ts for /api/* (address lookup, Add a place, ratings) and /p/*
// (a place's link, its preview naming the place).
// Connected to the GitHub repository (Workers Builds), each push to main runs `npm run build`,
// then `npx wrangler deploy` with this file. Deploying your own copy: change the name, the address
// and the database ID to yours, and set the TURNSTILE_SECRET secret.
{
  "name": "poutine",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/p/*"],
  },
  // Places visitors send, waiting for approval. migrations/ holds its tables.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poutine",
      "database_id": "d25cc4b1-fb54-4005-9b65-0c88236fee73",
      "migrations_dir": "migrations",
    },
  ],
  // Wrangler replaces the Worker's addresses with these on each deploy. www answers with a redirect
  // to poutines.app (a Redirect Rule, which runs before the Worker); it stays here for its DNS
  // record and certificate. The first address, poutine.ederer.digital, belongs to another
  // Cloudflare account, whose own Redirect Rule sends it here.
  "routes": [
    { "pattern": "poutines.app", "custom_domain": true },
    { "pattern": "www.poutines.app", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": false,
}
