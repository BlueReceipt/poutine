{
  "name": "poutine",
  "private": true,
  "version": "0.1.0",
  "description": "A map of Québec's casse-croûtes and potato shacks, with photos and prices from visitors.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite build && wrangler d1 migrations apply poutine --local && wrangler dev --port 4180",
    "build": "vite build",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "places": "node scripts/fetch-places.ts",
    "waiting": "node scripts/review.ts waiting",
    "approve": "node scripts/review.ts approve",
    "reject": "node scripts/review.ts reject",
    "ratings": "node scripts/review.ts ratings",
    "hide": "node scripts/review.ts hide",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "6.11.2",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.149.0"
  }
}
